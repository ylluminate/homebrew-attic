#!/usr/bin/env python3
"""
attic-sync — rescue Homebrew casks before they are disabled/removed.

Copies every cask that carries a `disable!` or `deprecate!` stanza out of
homebrew/cask, strips that stanza (which is the only thing blocking install),
and writes the result into this tap's Casks/ tree (sharded by first letter,
same as upstream). Definitions only — never binaries.

Idempotent: safe to re-run. Intended to run on a schedule so the tap keeps
pace with Homebrew's ongoing deprecations.

Usage:
  bin/attic-sync                       # clone homebrew/cask fresh, then sync
  bin/attic-sync --source /path/hb-cask  # use an existing checkout
  bin/attic-sync --dry-run             # report only, write nothing
"""
import argparse, os, re, subprocess, sys, tempfile, shutil

STANZA = re.compile(r'^[ \t]*(disable!|deprecate!)', re.MULTILINE)
REASON = re.compile(r'because:\s*:(\w+)')
DATERE = re.compile(r'date:\s*"([^"]+)"')

def strip_stanza(text):
    """Remove disable!/deprecate! statements (single or multi-line). Return (new_text, removed_list)."""
    lines = text.split('\n')
    out, removed, i = [], [], 0
    while i < len(lines):
        line = lines[i]
        if STANZA.match(line):
            stmt = [line]
            # continuation: keep consuming while the statement line ends in a comma
            while line.rstrip().endswith(',') and i + 1 < len(lines):
                i += 1
                line = lines[i]
                stmt.append(line)
            removed.append(' '.join(s.strip() for s in stmt))
            i += 1
            continue
        out.append(line)
        i += 1
    return '\n'.join(out), removed

def clone_cask(dest):
    print(f"cloning homebrew/cask -> {dest} ...", flush=True)
    subprocess.run(["git", "clone", "--depth", "1", "--quiet",
                    "https://github.com/Homebrew/homebrew-cask", dest], check=True)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--source", help="existing homebrew-cask checkout (else clone fresh)")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    tap = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    casks_out = os.path.join(tap, "Casks")

    tmp = None
    src = args.source
    if not src:
        tmp = tempfile.mkdtemp(prefix="hb-cask-")
        clone_cask(tmp); src = tmp
    src_casks = os.path.join(src, "Casks")
    if not os.path.isdir(src_casks):
        sys.exit(f"no Casks/ under {src}")

    manifest, rescued, skipped = [], 0, 0
    for root, _, files in os.walk(src_casks):
        for fn in files:
            if not fn.endswith(".rb"):
                continue
            sp = os.path.join(root, fn)
            text = open(sp, encoding="utf-8", errors="replace").read()
            if not STANZA.search(text):
                continue
            new_text, removed = strip_stanza(text)
            shard = os.path.basename(root)          # first-letter dir
            token = fn[:-3]
            reason = date = ""
            for r in removed:
                m = REASON.search(r);  reason = m.group(1) if m else reason
                d = DATERE.search(r);  date = d.group(1) if d else date
            manifest.append((token, shard, date, reason))
            if not args.dry_run:
                dd = os.path.join(casks_out, shard)
                os.makedirs(dd, exist_ok=True)
                open(os.path.join(dd, fn), "w", encoding="utf-8").write(new_text)
            rescued += 1

    if not args.dry_run:
        manifest.sort()
        with open(os.path.join(tap, "MANIFEST.tsv"), "w") as f:
            f.write("token\tshard\tdisable_date\treason\n")
            for t, s, d, r in manifest:
                f.write(f"{t}\t{s}\t{d}\t{r}\n")

    from collections import Counter
    by_reason = Counter(r or "?" for _, _, _, r in manifest)
    print(f"\nrescued {rescued} casks" + (" (dry-run, nothing written)" if args.dry_run else ""))
    print("by reason:")
    for r, n in by_reason.most_common():
        print(f"  {n:5}  {r}")

    if tmp:
        shutil.rmtree(tmp, ignore_errors=True)

if __name__ == "__main__":
    main()
